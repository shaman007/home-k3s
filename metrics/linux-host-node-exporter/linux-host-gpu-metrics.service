[Unit]
Description=Export NVIDIA GPU metrics for node exporter
After=local-fs.target
ConditionPathIsExecutable=/usr/bin/nvidia-smi

[Service]
Type=oneshot
StateDirectory=node_exporter
ExecStart=/usr/bin/python3 /usr/local/libexec/linux-host-collect-hardware-metrics gpu /var/lib/node_exporter/gpu.prom
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter
