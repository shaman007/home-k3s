[Unit]
Description=Export SMART disk metrics for node exporter
After=local-fs.target
ConditionPathIsExecutable=/usr/bin/smartctl

[Service]
Type=oneshot
StateDirectory=node_exporter
ExecStart=/usr/bin/python3 /usr/local/libexec/linux-host-collect-hardware-metrics smart /var/lib/node_exporter/smart.prom
IOSchedulingClass=idle
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter
