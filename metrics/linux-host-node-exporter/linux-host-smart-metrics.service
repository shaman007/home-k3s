[Unit]
Description=Export SMART disk metrics for node exporter
After=local-fs.target
ConditionPathIsExecutable=/usr/bin/smartctl

[Service]
Type=oneshot
StateDirectory=node_exporter
ExecStart=/usr/bin/python3 /home/shaman007/git/home-k3s/metrics/linux-host-node-exporter/collect-hardware-metrics.py smart /var/lib/node_exporter/smart.prom
IOSchedulingClass=idle
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter
