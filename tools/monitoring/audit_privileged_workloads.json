            "hostPath": {
              "path": "/boot/",
              "type": ""
            },
            "name": "boot"
          },
          {
            "hostPath": {
              "path": "/dev/",
              "type": ""
            },
            "name": "dev"
          },
          {
            "hostPath": {
              "path": "/proc/",
              "type": ""
            },
            "name": "proc"
          },
          {
            "hostPath": {
              "path": "/etc/",
              "type": ""
            },
            "name": "etc"
          },
          {
            "hostPath": {
              "path": "/var/lib/longhorn/",
              "type": ""
            },
            "name": "longhorn"
          }
