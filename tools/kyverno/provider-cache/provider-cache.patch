+package utils
+
+import (
+	"container/list"
+	"crypto/sha256"
+	"encoding/json"
+	"sort"
+	"sync"
+	"time"
+
+	policiesv1beta1 "github.com/kyverno/api/api/policies.kyverno.io/v1beta1"
+	vpolcompiler "github.com/kyverno/kyverno/pkg/cel/policies/vpol/compiler"
+	vpolengine "github.com/kyverno/kyverno/pkg/cel/policies/vpol/engine"
+	"github.com/kyverno/kyverno/pkg/logging"
+)
+
+// Share compiled programs, never resource decisions or request/namespace state.
+// A bounded, expiring cache also releases deleted policies and old revisions.
+var backgroundVpolProviders = newVpolProviderCache(8, 5*time.Minute)
+
+type vpolProviderEntry struct {
+	identity string
+	key      [32]byte
+	provider vpolengine.Provider
+	expires  time.Time
+}
+
+type vpolProviderCache struct {
+	mu       sync.Mutex
+	entries  map[[32]byte]*list.Element
+	lru      *list.List
+	capacity int
+	ttl      time.Duration
+	now      func() time.Time
+	build    func(policiesv1beta1.ValidatingPolicyLike, []*policiesv1beta1.PolicyException) (vpolengine.Provider, error)
+}
+
+func newVpolProviderCache(capacity int, ttl time.Duration) *vpolProviderCache {
+	return &vpolProviderCache{entries: make(map[[32]byte]*list.Element), lru: list.New(), capacity: capacity, ttl: ttl, now: time.Now,
+		build: func(p policiesv1beta1.ValidatingPolicyLike, e []*policiesv1beta1.PolicyException) (vpolengine.Provider, error) {
+			return vpolengine.NewProvider(vpolcompiler.NewCompiler(), []policiesv1beta1.ValidatingPolicyLike{p}, e)
+		}}
+}
+
+func (c *vpolProviderCache) get(policy policiesv1beta1.ValidatingPolicyLike, exceptions []*policiesv1beta1.PolicyException) (vpolengine.Provider, error) {
+	if c.capacity <= 0 {
+		return c.build(policy, exceptions)
+	} // Exact upstream baseline for equivalence tests.
+	// Match the upstream provider's exception selection. Informer List order is
+	// unspecified; canonicalize it so identical exception sets reuse one provider.
+	// Hash full objects, not just resourceVersion: this also works for offline
+	// fixtures and delete/recreate, and includes namespace, kind and autogen config.
+	var matched []*policiesv1beta1.PolicyException
+	for _, e := range exceptions {
+		for _, ref := range e.Spec.PolicyRefs {
+			if ref.Name == policy.GetName() && ref.Kind == policy.GetKind() {
+				matched = append(matched, e)
+				break
+			}
+		}
+	}
+	sort.SliceStable(matched, func(i, j int) bool {
+		a, b := matched[i], matched[j]
+		if a.Namespace != b.Namespace {
+			return a.Namespace < b.Namespace
+		}
+		if a.Name != b.Name {
+			return a.Name < b.Name
+		}
+		return string(a.UID) < string(b.UID)
+	})
+	expired := make([]bool, len(matched))
+	for i, e := range matched {
+		expired[i] = e.IsExpired()
+	}
+	raw, err := json.Marshal(struct {
+		Policy     policiesv1beta1.ValidatingPolicyLike
+		Exceptions []*policiesv1beta1.PolicyException
+		Expired    []bool
+	}{policy, matched, expired})
+	if err != nil {
+		return nil, err
+	}
+	key := sha256.Sum256(raw)
+	// Serialize cold compilation to coalesce concurrent misses for the same key.
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	now := c.now()
+	identity := policy.GetKind() + "/" + policy.GetNamespace() + "/" + policy.GetName()
+	for e := c.lru.Back(); e != nil; {
+		prev := e.Prev()
+		entry := e.Value.(vpolProviderEntry)
+		if !now.Before(entry.expires) || (entry.identity == identity && entry.key != key) {
+			delete(c.entries, entry.key)
+			c.lru.Remove(e)
+		}
+		e = prev
+	}
+	if e := c.entries[key]; e != nil {
+		c.lru.MoveToFront(e)
+		return e.Value.(vpolProviderEntry).provider, nil
+	}
+	// Own a snapshot: compiled exception programs retain their source objects.
+	snapshot := policy.DeepCopyObject().(policiesv1beta1.ValidatingPolicyLike)
+	copies := make([]*policiesv1beta1.PolicyException, len(matched))
+	for i, e := range matched {
+		copies[i] = e.DeepCopy()
+	}
+	provider, err := c.build(snapshot, copies)
+	if err != nil {
+		return nil, err
+	} // Never serve a stale provider after compile failure.
+	if c.capacity <= 0 {
+		return provider, nil
+	}
+	if c.lru.Len() >= c.capacity {
+		e := c.lru.Back()
+		delete(c.entries, e.Value.(vpolProviderEntry).key)
+		c.lru.Remove(e)
+	}
+	e := c.lru.PushFront(vpolProviderEntry{identity, key, provider, c.now().Add(c.ttl)})
+	c.entries[key] = e
+	logging.GlobalLogger().V(2).Info("compiled background ValidatingPolicy provider", "policy", policy.GetName(), "namespace", policy.GetNamespace(), "cacheEntries", c.lru.Len())
+	return provider, nil
+}
