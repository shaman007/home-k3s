+package utils
+
+import (
+	"encoding/json"
+	policies "github.com/kyverno/api/api/policies.kyverno.io/v1beta1"
+	engineapi "github.com/kyverno/kyverno/pkg/engine/api"
+	reportutils "github.com/kyverno/kyverno/pkg/utils/report"
+	"github.com/stretchr/testify/require"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// Compare the actual background scanner, not the CLI's different evaluation path.
+// Fixtures contain only policies, reviewed exceptions and security-context resources.
+func TestVpolProviderCacheEquivalence(t *testing.T) {
+	reportutils.NewReportingConfig([]string{"pass", "fail", "error", "warn", "skip"}, "validate")
+	dir := os.Getenv("KYVERNO_CACHE_FIXTURES")
+	if dir == "" {
+		t.Skip("set KYVERNO_CACHE_FIXTURES to the fixture directory")
+	}
+	read := func(name string, v any) {
+		b, err := os.ReadFile(filepath.Join(dir, name))
+		require.NoError(t, err)
+		require.NoError(t, json.Unmarshal(b, v))
+	}
+	var ps []policies.ValidatingPolicy
+	var es []*policies.PolicyException
+	var rs []unstructured.Unstructured
+	read("kyverno-cache-policies.json", &ps)
+	read("kyverno-cache-exceptions.json", &es)
+	read("kyverno-cache-resources.json", &rs)
+	pols := make([]engineapi.GenericPolicy, len(ps))
+	for i := range ps {
+		pols[i] = engineapi.NewValidatingPolicy(&ps[i])
+	}
+	original := backgroundVpolProviders
+	defer func() { backgroundVpolProviders = original }()
+	evaluate := func(capacity int) ([]string, time.Duration) {
+		backgroundVpolProviders = newVpolProviderCache(capacity, 5*time.Minute)
+		started := time.Now()
+		out := []string{}
+		counts := map[string]int{}
+		scanner := newTestScanner(t)
+		for _, r := range rs {
+			group := r.GroupVersionKind().Group
+			resource := map[string]string{"Pod": "pods", "Deployment": "deployments", "DaemonSet": "daemonsets", "StatefulSet": "statefulsets", "CronJob": "cronjobs", "Job": "jobs", "ReplicaSet": "replicasets"}[r.GetKind()]
+			gvr := schema.GroupVersionResource{Group: group, Version: r.GroupVersionKind().Version, Resource: resource}
+			results := scanner.ScanResource(t.Context(), r, gvr, "", &corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: r.GetNamespace()}}, nil, nil, es, pols...)
+			byPolicy := map[string]any{}
+			for p, result := range results {
+				require.NoError(t, result.Error)
+				require.NotNil(t, result.EngineResponse)
+				rr := reportutils.EngineResponseToReportResults(*result.EngineResponse)
+				for i := range rr {
+					rr[i].Timestamp = metav1.Timestamp{}
+					counts[string(rr[i].Result)]++
+				}
+				byPolicy[(*p).GetName()] = rr
+			}
+			b, err := json.Marshal(byPolicy)
+			require.NoError(t, err)
+			out = append(out, string(b))
+		}
+		t.Logf("capacity=%d resources=%d outcomes=%v elapsed=%s", capacity, len(rs), counts, time.Since(started))
+		return out, time.Since(started)
+	}
+	before, beforeTime := evaluate(0)
+	after, afterTime := evaluate(64)
+	require.Equal(t, before, after)
+	t.Logf("identical scanner results; speedup %.2fx", float64(beforeTime)/float64(afterTime))
+}
+
+func TestVpolProviderCacheExceptionUpdates(t *testing.T) {
+	original := backgroundVpolProviders
+	defer func() { backgroundVpolProviders = original }()
+	backgroundVpolProviders = newVpolProviderCache(64, time.Minute)
+	var p policies.ValidatingPolicy
+	require.NoError(t, json.Unmarshal([]byte(`{"apiVersion":"policies.kyverno.io/v1beta1","kind":"ValidatingPolicy","metadata":{"name":"test"},"spec":{"validationActions":["Audit"],"failurePolicy":"Ignore","matchConstraints":{"resourceRules":[{"apiGroups":[""],"apiVersions":["v1"],"resources":["pods"],"operations":["CREATE","UPDATE"]}]},"validations":[{"expression":"false","message":"deliberate violation"}]}}`), &p))
+	var e policies.PolicyException
+	require.NoError(t, json.Unmarshal([]byte(`{"apiVersion":"policies.kyverno.io/v1beta1","kind":"PolicyException","metadata":{"name":"exception","namespace":"kyverno"},"spec":{"policyRefs":[{"name":"test","kind":"ValidatingPolicy"}],"matchConditions":[{"name":"target","expression":"object.metadata.name == 'allowed'"}]}}`), &e))
+	r := unstructured.Unstructured{Object: map[string]any{"apiVersion": "v1", "kind": "Pod", "metadata": map[string]any{"name": "allowed", "namespace": "test"}, "spec": map[string]any{"containers": []any{map[string]any{"name": "test", "image": "example.com/test:v1"}}}}}
+	sc := newTestScanner(t)
+	check := func(ex []*policies.PolicyException, want string) {
+		results := sc.ScanResource(t.Context(), r, schema.GroupVersionResource{Version: "v1", Resource: "pods"}, "", &corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: "test"}}, nil, nil, ex, engineapi.NewValidatingPolicy(&p))
+		require.Len(t, results, 1)
+		for _, result := range results {
+			require.NoError(t, result.Error)
+			require.NotNil(t, result.EngineResponse)
+			require.NotEmpty(t, result.EngineResponse.PolicyResponse.Rules)
+			require.Equal(t, want, string(result.EngineResponse.PolicyResponse.Rules[0].Status()))
+		}
+	}
+	check([]*policies.PolicyException{&e}, "skip")
+	r.SetName("outside")
+	check([]*policies.PolicyException{&e}, "fail")
+	r.SetName("allowed")
+	e.Spec.MatchConditions[0].Expression = "false"
+	check([]*policies.PolicyException{&e}, "fail")
+	e.Spec.MatchConditions[0].Expression = "true"
+	check([]*policies.PolicyException{&e}, "skip")
+	check(nil, "fail")
+	p.Spec.Validations[0].Expression = "true"
+	check(nil, "pass")
+	p.Spec.Validations[0].Expression = "invalid CEL !" // Changed invalid policy cannot use its previous pass provider.
+	results := sc.ScanResource(t.Context(), r, schema.GroupVersionResource{Version: "v1", Resource: "pods"}, "", nil, nil, nil, nil, engineapi.NewValidatingPolicy(&p))
+	for _, result := range results {
+		require.Error(t, result.Error)
+	}
+}
