+package utils
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	policies "github.com/kyverno/api/api/policies.kyverno.io/v1beta1"
+	vpolengine "github.com/kyverno/kyverno/pkg/cel/policies/vpol/engine"
+	"github.com/stretchr/testify/require"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func cachePolicy(name string) *policies.ValidatingPolicy {
+	return &policies.ValidatingPolicy{TypeMeta: metav1.TypeMeta{APIVersion: "policies.kyverno.io/v1beta1", Kind: "ValidatingPolicy"}, ObjectMeta: metav1.ObjectMeta{Name: name, ResourceVersion: "1"}}
+}
+func cacheException() *policies.PolicyException {
+	e := &policies.PolicyException{ObjectMeta: metav1.ObjectMeta{Name: "exception", Namespace: "kyverno", ResourceVersion: "1"}}
+	e.Spec.PolicyRefs = append(e.Spec.PolicyRefs, policies.PolicyRef{Name: "test", Kind: "ValidatingPolicy"})
+	return e
+}
+func TestVpolProviderCache(t *testing.T) {
+	c := newVpolProviderCache(2, time.Minute)
+	now := time.Now()
+	c.now = func() time.Time { return now }
+	calls := 0
+	c.build = func(p policies.ValidatingPolicyLike, e []*policies.PolicyException) (vpolengine.Provider, error) {
+		calls++
+		return vpolengine.ProviderFunc(func(context.Context) ([]vpolengine.Policy, error) { return nil, nil }), nil
+	}
+	p := cachePolicy("test")
+	e := cacheException()
+	_, err := c.get(p, []*policies.PolicyException{e})
+	require.NoError(t, err)
+	_, err = c.get(p, []*policies.PolicyException{e})
+	require.NoError(t, err)
+	require.Equal(t, 1, calls)
+	p.ResourceVersion = "2"
+	_, err = c.get(p, []*policies.PolicyException{e})
+	require.NoError(t, err)
+	require.Equal(t, 2, calls)
+	e.ResourceVersion = "2"
+	_, err = c.get(p, []*policies.PolicyException{e})
+	require.NoError(t, err)
+	require.Equal(t, 3, calls)
+	require.Len(t, c.entries, 1)
+	// Deleting an exception must not retain the exemption.
+	_, err = c.get(p, nil)
+	require.NoError(t, err)
+	require.Equal(t, 4, calls)
+	now = now.Add(2 * time.Minute)
+	_, err = c.get(p, nil)
+	require.NoError(t, err)
+	require.Equal(t, 5, calls)
+	require.Len(t, c.entries, 1)
+	// An invalid new revision must not return the previous compiled policy.
+	c.build = func(p policies.ValidatingPolicyLike, e []*policies.PolicyException) (vpolengine.Provider, error) {
+		return nil, errors.New("invalid policy")
+	}
+	p.ResourceVersion = "3"
+	_, err = c.get(p, nil)
+	require.Error(t, err)
+}
+func TestVpolProviderCacheConcurrentSnapshot(t *testing.T) {
+	c := newVpolProviderCache(2, time.Minute)
+	calls := 0
+	var retained *policies.PolicyException
+	c.build = func(p policies.ValidatingPolicyLike, e []*policies.PolicyException) (vpolengine.Provider, error) {
+		calls++
+		retained = e[0]
+		return vpolengine.ProviderFunc(func(context.Context) ([]vpolengine.Policy, error) { return nil, nil }), nil
+	}
+	p := cachePolicy("test")
+	e := cacheException()
+	var wg sync.WaitGroup
+	for range 16 {
+		wg.Go(func() {
+			_, err := c.get(p, []*policies.PolicyException{e})
+			if err != nil {
+				t.Error(err)
+			}
+		})
+	}
+	wg.Wait()
+	require.Equal(t, 1, calls)
+	e.Name = "changed"
+	require.Equal(t, "exception", retained.Name)
+	// A policy's namespace participates in identity even with the same name/RV.
+	p.Namespace = "tenant-b"
+	_, err := c.get(p, []*policies.PolicyException{e})
+	require.NoError(t, err)
+	require.Equal(t, 2, calls)
+}
+
+func TestVpolProviderCacheExpiryBoundary(t *testing.T) {
+	c := newVpolProviderCache(2, time.Minute)
+	calls := 0
+	c.build = func(p policies.ValidatingPolicyLike, e []*policies.PolicyException) (vpolengine.Provider, error) {
+		calls++
+		return vpolengine.ProviderFunc(func(context.Context) ([]vpolengine.Policy, error) { return nil, nil }), nil
+	}
+	e := cacheException()
+	deadline := metav1.NewTime(time.Now().Add(50 * time.Millisecond))
+	e.Spec.ExpiresAt = &deadline
+	_, err := c.get(cachePolicy("test"), []*policies.PolicyException{e})
+	require.NoError(t, err)
+	time.Sleep(60 * time.Millisecond)
+	_, err = c.get(cachePolicy("test"), []*policies.PolicyException{e})
+	require.NoError(t, err)
+	require.Equal(t, 2, calls)
+}
+
+func TestVpolProviderCacheInformerOrder(t *testing.T) {
+	c := newVpolProviderCache(8, time.Minute)
+	calls := 0
+	c.build = func(p policies.ValidatingPolicyLike, e []*policies.PolicyException) (vpolengine.Provider, error) {
+		calls++
+		require.Equal(t, "a", e[0].Name)
+		return vpolengine.ProviderFunc(func(context.Context) ([]vpolengine.Policy, error) { return nil, nil }), nil
+	}
+	a, b := cacheException(), cacheException()
+	a.Name = "a"
+	b.Name = "b"
+	for i := 0; i < 100; i++ {
+		es := []*policies.PolicyException{a, b}
+		if i%2 == 0 {
+			es = []*policies.PolicyException{b, a}
+		}
+		_, err := c.get(cachePolicy("test"), es)
+		require.NoError(t, err)
+	}
+	require.Equal(t, 1, calls)
+	require.Len(t, c.entries, 1)
+}
+
+func TestVpolProviderCacheCapacity(t *testing.T) {
+	c := newVpolProviderCache(2, time.Minute)
+	c.build = func(p policies.ValidatingPolicyLike, e []*policies.PolicyException) (vpolengine.Provider, error) {
+		return vpolengine.ProviderFunc(func(context.Context) ([]vpolengine.Policy, error) { return nil, nil }), nil
+	}
+	for _, name := range []string{"a", "b", "c"} {
+		_, err := c.get(cachePolicy(name), nil)
+		require.NoError(t, err)
+	}
+	require.Len(t, c.entries, 2)
+}
