{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "registryAliases": {
    "harbor.andreybondarenko.com/dockerhub": "index.docker.io",
    "harbor.andreybondarenko.com/google": "gcr.io",
    "harbor.andreybondarenko.com/github": "ghcr.io",
    "harbor.andreybondarenko.com/quay": "quay.io"
  },
  "platformCommit": "enabled",
  "automergeType": "pr",
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "ignorePaths": ["DEPRECATED/**"],
  "argocd": {
    "managerFilePatterns": ["/^argocd\\/application-.*\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^mastodon\\/mastodon-values\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the private Traefik image embedded in Argo Helm values",
      "managerFilePatterns": ["/^argocd\\/application-traefik-private\\.yaml$/"],
      "matchStrings": [
        "image:\\s+registry: docker\\.io\\s+repository: traefik\\s+tag: (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "docker.io/traefik",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update full image references embedded in Mastodon Helm values",
      "managerFilePatterns": ["/^mastodon\\/mastodon-values\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s+(?<depName>[^\\s:]+(?:/[^\\s:]+)+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Update both private Traefik image declarations in the same PR",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/traefik"],
      "matchFileNames": [
        "argocd/application-traefik-private.yaml",
        "traefik-private/values.yaml"
      ],
      "groupName": "private Traefik image",
      "groupSlug": "private-traefik-image"
    },
    {
      "description": "Keep Mastodon Helm tags valid for chart version labels",
      "matchManagers": ["helm-values"],
      "matchFileNames": ["mastodon/mastodon-values.yaml"],
      "matchPackageNames": ["harbor.andreybondarenko.com/library/mastodon"],
      "pinDigests": false
    },
    {
      "description": "Keep GitHub Actions pinned to immutable commit SHAs",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Use calendar versioning for locally built images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.andreybondarenko.com/library/**"],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})-(?<build>\\d{6})$"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update"]
    },
    {
      "description": "Require review for Argo CD minor and major upgrades",
      "matchManagers": ["kustomize"],
      "matchFileNames": ["argocd-install/kustomization.yaml"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "labels": ["argocd-upgrade"]
    },
    {
      "description": "Keep Firefox Sync MariaDB on the validated 12.3 LTS series",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "firefox-sync/deployment-mariadb.yaml"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/dockerhub/mariadb"
      ],
      "allowedVersions": "/^12\\.3\\./",
      "pinDigests": true
    }
  ]
}
