{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "registryAliases": {
    "harbor.andreybondarenko.com/dockerhub": "index.docker.io",
    "harbor.andreybondarenko.com/google": "gcr.io",
    "harbor.andreybondarenko.com/github": "ghcr.io",
    "harbor.andreybondarenko.com/quay": "quay.io"
  },
  "gitAuthor": "Andrey Bondarenko <me@andreybondarenko.com>",
  "prHourlyLimit": 0,
  "ignorePaths": ["DEPRECATED/**"],
  "argocd": {
    "managerFilePatterns": ["/^argocd\\/application-.*\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^mastodon\\/mastodon-values\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update full image references embedded in Mastodon Helm values",
      "managerFilePatterns": ["/^mastodon\\/mastodon-values\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s+(?<depName>[^\\s:]+(?:/[^\\s:]+)+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Use calendar versioning for locally built images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.andreybondarenko.com/library/**"],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})-(?<build>\\d{6})$"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update"]
    },
    {
      "description": "Require review for Argo CD minor and major upgrades",
      "matchManagers": ["kustomize"],
      "matchFileNames": ["argocd-install/kustomization.yaml"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "labels": ["argocd-upgrade"]
    }
  ]
}
