{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "registryAliases": {
    "harbor.andreybondarenko.com/dockerhub": "index.docker.io",
    "harbor.andreybondarenko.com/google": "gcr.io",
    "harbor.andreybondarenko.com/github": "ghcr.io",
    "harbor.andreybondarenko.com/quay": "quay.io"
  },
  "platformCommit": "enabled",
  "automergeType": "pr",
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "ignorePaths": [
    "DEPRECATED/**"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^argocd\\/application-.*\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^mastodon\\/mastodon-values\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the private Traefik image embedded in Argo Helm values",
      "managerFilePatterns": [
        "/^argocd\\/application-traefik-private\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s+registry: docker\\.io\\s+repository: traefik\\s+tag: (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "docker.io/traefik",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update full image references embedded in Mastodon Helm values",
      "managerFilePatterns": [
        "/^mastodon\\/mastodon-values\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[^\\s:]+(?:/[^\\s:]+)+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update CI release versions and their archive SHA256 together",
      "managerFilePatterns": [
        "/^tools\\/ci\\/tool-versions\\.json$/"
      ],
      "matchStrings": [
        "\"depName\":\\s*\"(?<depName>[^\"\\s]+)\",\\s*\"version\":\\s*\"(?<currentValue>[^\"\\s]+)\",\\s*\"sha256\":\\s*\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Keep the backup retention generator image digest aligned with its generated manifest",
      "managerFilePatterns": [
        "/^tools\\/generate_backup_retention\\.py$/"
      ],
      "matchStrings": [
        "'(?<depName>harbor\\.andreybondarenko\\.com/dockerhub/amazon/aws-cli)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ],
      "datasourceTemplate": "docker",
      "currentValueTemplate": "latest"
    }
  ],
  "packageRules": [
    {
      "description": "Update both private Traefik image declarations in the same PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/traefik"
      ],
      "matchFileNames": [
        "argocd/application-traefik-private.yaml",
        "traefik-private/values.yaml"
      ],
      "groupName": "private Traefik image",
      "groupSlug": "private-traefik-image"
    },
    {
      "description": "Keep Mastodon Helm tags valid for chart version labels",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "mastodon/mastodon-values.yaml"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/library/mastodon"
      ],
      "pinDigests": false
    },
    {
      "description": "Keep GitHub Actions pinned to immutable commit SHAs",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action",
        "workflow"
      ],
      "pinDigests": true
    },
    {
      "description": "Use calendar versioning for locally built images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/library/**"
      ],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})-(?<build>\\d{6})$"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "major-update"
      ]
    },
    {
      "description": "Require review for Argo CD minor and major upgrades",
      "matchManagers": [
        "kustomize"
      ],
      "matchFileNames": [
        "argocd-install/kustomization.yaml"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false,
      "labels": [
        "argocd-upgrade"
      ]
    },
    {
      "description": "Keep Firefox Sync MariaDB on the validated 12.3 LTS series",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "firefox-sync/deployment-mariadb.yaml"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/dockerhub/mariadb"
      ],
      "allowedVersions": "/^12\\.3\\./",
      "pinDigests": true
    },
    {
      "description": "Keep each CI tool version and archive digest in one PR, including major updates",
      "matchDatasources": [
        "github-release-attachments"
      ],
      "matchFileNames": [
        "tools/ci/tool-versions.json"
      ],
      "pinDigests": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Keycloak supports PostgreSQL18; major upgrades require a tested migration",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "keycloak/**"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/dockerhub/postgres"
      ],
      "allowedVersions": "/^18(?:\\.|$)/",
      "ignoreUnstable": true
    },
    {
      "description": "bitwarden: PostgreSQL19 data-volume migration is verified; later majors require a new migration",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "bitwarden/**"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/dockerhub/postgres"
      ],
      "allowedVersions": "/^19(?:\\.|$)/",
      "ignoreUnstable": true
    },
    {
      "description": "mastodon: PostgreSQL19 data-volume migration is verified; later majors require a new migration",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "mastodon/**"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/dockerhub/postgres"
      ],
      "allowedVersions": "/^19(?:\\.|$)/",
      "ignoreUnstable": true
    },
    {
      "description": "Dawarich uses verified PostgreSQL18/PostGIS; PostgreSQL19 requires a separate supported migration",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "dawarich/**"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/github/cloudnative-pg/postgis",
        "harbor.andreybondarenko.com/dockerhub/postgis/postgis"
      ],
      "allowedVersions": "/^18(?:[.-]|$)/",
      "ignoreUnstable": true
    },
    {
      "description": "Immich uses verified PostgreSQL18/VectorChord; PostgreSQL19 images and extension support are not yet available",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "immich/**"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/github/immich-app/postgres"
      ],
      "allowedVersions": "/^18-vectorchord/",
      "ignoreUnstable": true
    },
    {
      "description": "DocumentDB currently supports PostgreSQL17; keep its major and review paired FerretDB upgrades",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "your-spotify/**"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/github/ferretdb/postgres-documentdb"
      ],
      "allowedVersions": "/^17-/",
      "ignoreUnstable": true,
      "automerge": false
    },
    {
      "description": "Review FerretDB and DocumentDB together to preserve their compatibility pair",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "your-spotify/**"
      ],
      "matchPackageNames": [
        "harbor.andreybondarenko.com/github/ferretdb/ferretdb",
        "harbor.andreybondarenko.com/github/ferretdb/postgres-documentdb"
      ],
      "groupName": "FerretDB and DocumentDB compatibility",
      "automerge": false
    },
    {
      "description": "Keep Harbor on its verified chart series; bundled PostgreSQL changes require vendor migration review",
      "matchManagers": [
        "argocd"
      ],
      "matchDatasources": [
        "helm"
      ],
      "matchFileNames": [
        "argocd/application-harbor.yaml"
      ],
      "matchPackageNames": [
        "harbor"
      ],
      "allowedVersions": "/^1\\.19\\./",
      "ignoreUnstable": true
    }
  ]
}
