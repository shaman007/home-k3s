--- /dev/null
+++ b/unifi-console-dns.tf
@@ -0,0 +1,12 @@
+# Router TLS identity: this name points directly to the gateway, not private ingress.
+resource "unifi_dns_record" "console_tls" {
+  name        = "unifi.int.andreybondarenko.com"
+  record_type = "A"
+  value       = "192.168.1.1"
+  enabled     = true
+  ttl         = "1m0s"
+  site        = "default"
+  lifecycle {
+    prevent_destroy = true
+  }
+}
